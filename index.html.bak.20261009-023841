<!doctype html>
<html lang="tr">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#171717"><meta name="description" content="Kupon ve indirim merkezi">
<link rel="manifest" href="./manifest.json"><link rel="icon" href="./icons/icon-192.png">
<meta property="og:type" content="website"><meta property="og:title" content="Kupon Merkezi"><meta property="og:description" content="Güncel kupon ve indirimler"><meta property="og:image" content="./icons/icon-512.png">
<title>Kupon Merkezi</title>
<style>
:root{color-scheme:dark;--bg:#0d0f12;--card:#171a1f;--text:#f5f7fa;--muted:#aab1bb;--accent:#ffcf33;--line:#2a2f37}*{box-sizing:border-box}body{margin:0;background:linear-gradient(180deg,#0d0f12,#12161b);color:var(--text);font:16px system-ui,-apple-system,Segoe UI,Roboto,sans-serif}main{max-width:680px;margin:auto;padding:24px 16px 48px}.hero{padding:24px 4px 18px}.hero h1{font-size:32px;margin:0 0 8px}.hero p{color:var(--muted);margin:0}.card{background:var(--card);border:1px solid var(--line);border-radius:22px;padding:18px;margin:14px 0;box-shadow:0 12px 30px #0005}.coupon{display:flex;gap:14px;align-items:center}.coupon img{width:74px;height:74px;border-radius:16px;object-fit:cover}.coupon h2{margin:0 0 5px;font-size:20px}.coupon p{margin:0;color:var(--muted)}button,.cta{display:block;width:100%;border:0;border-radius:15px;padding:15px 18px;margin-top:16px;background:var(--accent);color:#111;font-weight:800;font-size:16px;text-align:center;text-decoration:none}.secondary{background:#252a32;color:#fff}.consent{font-size:13px;color:var(--muted);line-height:1.45}.consent label{display:flex;gap:10px;align-items:flex-start}.consent input{margin-top:3px}.status{font-size:12px;color:var(--muted);min-height:18px}.splash{position:fixed;inset:0;background:#0d0f12;display:grid;place-items:center;z-index:20;transition:opacity .35s}.splash img{width:104px;height:104px;border-radius:24px}.splash.hide{opacity:0;pointer-events:none}
</style></head>
<body>
<div class="splash" id="splash"><img src="./icons/icon-192.png" alt="Kupon"></div>
<main>
<section class="hero"><h1>Kupon Merkezi</h1><p>İndirimleri keşfet, kuponu aç ve fırsata git.</p></section>
<section class="card coupon">
<img src="./icons/icon-192.png" alt="Kupon görseli">
<div><h2>Güncel Fırsat</h2><p>Kuponu görüntülemek için devam et.</p></div>
</section>
<section class="card">
<p class="consent"><label><input id="consent" type="checkbox"> İstatistik amacıyla anonimleştirilmiş tıklama verilerinin işlenmesini kabul ediyorum.</label></p>
<a class="cta" id="couponLink" href="https://github.com/Sokmarket/Kupon" rel="noopener noreferrer">Kuponu Gör</a>
<div class="status" id="status"></div>
</section>
</main>
<script>
const CONFIG={analyticsBase:window.ANALYTICS_BASE_URL||localStorage.getItem('analyticsBase')||''};
const consent=document.querySelector('#consent'); const status=document.querySelector('#status');
consent.checked=localStorage.getItem('analytics-consent')==='1';
consent.addEventListener('change',()=>{localStorage.setItem('analytics-consent',consent.checked?'1':'0');});
function sendClick(target){if(!consent.checked||!CONFIG.analyticsBase)return;const body=JSON.stringify({event:'coupon_click',target,page:location.pathname,ref:new URLSearchParams(location.search).get('ref')||'',consent:true,timestamp:new Date().toISOString()});const url=CONFIG.analyticsBase.replace(/\/$/,'')+'/api/click';try{navigator.sendBeacon(url,new Blob([body],{type:'application/json'}))||fetch(url,{method:'POST',headers:{'Content-Type':'application/json'},body,keepalive:true}).catch(()=>{});}catch{} }
document.querySelector('#couponLink').addEventListener('click',()=>sendClick('couponLink'));
setTimeout(()=>document.querySelector('#splash').classList.add('hide'),700);
if('serviceWorker' in navigator)navigator.serviceWorker.register('./sw.js').catch(()=>{});
</script></body></html>
